# Upstash Redis via Vercel Marketplace (Storage → Redis)
# Vercel KV integrations inject these names:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or native Upstash names:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: require a shared access token for GET/PATCH /api/shim-sham in production.
# When set, the sheet shows an unlock screen until the token is entered.
# Generate with: openssl rand -hex 32
SHIM_SHAM_ACCESS_TOKEN=

# Optional: separate secret for signing the auth cookie (defaults to SHIM_SHAM_ACCESS_TOKEN).
# SHIM_SHAM_COOKIE_SECRET=
